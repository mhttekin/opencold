{
  "permissions": {
    "deny": [
      "Read(./**/.env*)",
      "Edit(./evals/labels/**)",
      "Write(./evals/labels/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh"
          }
        ]
      }
    ]
  }
}
